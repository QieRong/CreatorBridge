{
  "name": "creator-bridge",
  "version": "1.0.0",
  "description": "CreatorBridge 多平台内容适配发布助手 - 暑期实训营项目",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "creator",
    "publishing",
    "formatter",
    "electron"
  ],
  "author": "QieRong",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.creatorbridge.app",
    "productName": "CreatorBridge",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "files": [
      "index.html",
      "src/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CreatorBridge"
    }
  }
}
